# Interface the HTTP server binds to: 127.0.0.1 for local development, 0.0.0.0 in a container.
HOST=
# TCP port of the HTTP server.
PORT=
# Pino log level: fatal, error, warn, info, debug or trace.
LOG_LEVEL=
# Origin of the web app allowed by CORS with credentials: scheme, host and port without a path.
WEB_ORIGIN=
